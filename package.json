{
  "name": "mindmapmate",
  "version": "1.1.3",
  "private": true,
  "description": "Visual task mindmap board for Obsidian",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production && node scripts/scan-bundle.mjs",
    "test": "vitest run",
    "lint": "eslint src",
    "ship": "npm run build && node scripts/ship.mjs",
    "fixtures": "node scripts/make-fixtures.ts && mkdir -p ../test-vault/Fixtures && cp --update=none test/fixtures/*.board.md ../test-vault/Fixtures/",
    "obsidian:check": "node test/obsidian/check.mjs",
    "obsidian:perf": "node test/obsidian/perf.mjs",
    "showcase": "node test/obsidian/showcase.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "obsidian": "1.14.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
